# Copernicus Data Space Ecosystem (CDSE)
GEOHARVEST_CDSE_S3_ACCESS_KEY=
GEOHARVEST_CDSE_S3_SECRET_KEY=
GEOHARVEST_CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
GEOHARVEST_CDSE_USERNAME=
GEOHARVEST_CDSE_PASSWORD=

# ISRO / Bhuvan
GEOHARVEST_ISRO_USERNAME=
GEOHARVEST_ISRO_API_TOKEN=

# NASA Earthdata
GEOHARVEST_EARTHDATA_USERNAME=
GEOHARVEST_EARTHDATA_PASSWORD=
GEOHARVEST_EARTHDATA_TOKEN=

# Google Earth Engine
GEOHARVEST_EE_PROJECT=

# (Optional) Local Computer Storage Paths for Docker
# By default, files are saved to ./data/downloads on your local computer.
# You can customize these paths to save anywhere on your machine (e.g. ~/Downloads or /media/external):
# LOCAL_DOWNLOADS_DIR=./data/downloads
# LOCAL_PROCESSED_DIR=./data/processed
