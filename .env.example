# GeoHarvest Environment Configuration
# Copy this file to .env to override defaults

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_USER=geouser
POSTGRES_PASSWORD=geopass
POSTGRES_DB=geoharvest
POSTGRES_PORT=5433

# Or provide a direct database URL (overrides user/password/host/db)
# GEOHARVEST_DATABASE_URL=postgresql+psycopg2://geouser:geopass@db:5432/geoharvest

# ==========================================
# Server Configuration
# ==========================================
GEOHARVEST_HOST=0.0.0.0
GEOHARVEST_PORT=9009

# ==========================================
# Host Directories Overrides (Optional)
# ==========================================
# LOCAL_DOWNLOADS_DIR=./data/downloads
# LOCAL_PROCESSED_DIR=./data/processed

# ==========================================
# Copernicus Data Space Ecosystem (CDSE)
# ==========================================
GEOHARVEST_CDSE_S3_ACCESS_KEY=
GEOHARVEST_CDSE_S3_SECRET_KEY=
GEOHARVEST_CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
GEOHARVEST_CDSE_USERNAME=
GEOHARVEST_CDSE_PASSWORD=

# ==========================================
# ISRO / Bhuvan
# ==========================================
GEOHARVEST_ISRO_USERNAME=
GEOHARVEST_ISRO_API_TOKEN=

# ==========================================
# NASA Earthdata
# ==========================================
GEOHARVEST_EARTHDATA_USERNAME=
GEOHARVEST_EARTHDATA_PASSWORD=
GEOHARVEST_EARTHDATA_TOKEN=

# ==========================================
# Google Earth Engine
# ==========================================
GEOHARVEST_EE_PROJECT=
